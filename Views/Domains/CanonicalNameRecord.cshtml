@{
    ViewData["Title"] = "Canonical Name Record";
}
@model AspnetCoreMvcFull.Models.Record
@* ************** Content ************** *@
<div class="row g-6">
    <div class="col-md-7">
        <div class="card mb-6">
            <h5 class="card-header">Canonical Name Record</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <form asp-action="CanonicalNameRecord" asp-controller="Domains" method="post">
                    <div class="input-group mb-6">
                        <span class="input-group-text" id="ip">Domain</span>
                        <input asp-for="@Model.Domain" value="@Model.Domain" type="text" class="form-control" placeholder="URL" aria-label="ip" aria-describedby="ip" />
                    </div>
                    <button type="submit" class="btn btn-primary">Check</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card mb-6">
            <h5 class="card-header">Result</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <div class="input-group">
                    <span class="input-group-text">Name Server</span>
                    <textarea class="form-control" aria-label="With textarea" placeholder="Comment" readonly>
                        @{
                            if (Model != null && !string.IsNullOrEmpty(Model.CanonicalName[0]))
                            {
                                @Model.CanonicalName
                            }
                        }
                    </textarea>
                </div>
            </div>
        </div>
    </div>
</div>
