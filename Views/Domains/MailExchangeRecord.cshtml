@{
    ViewData["Title"] = "Mail Exchange Record";
}
@model AspnetCoreMvcFull.Models.Record
@* ************** Content ************** *@
<div class="row g-6">
    <div class="col-md-7">
        <div class="card mb-6">
            <h5 class="card-header">Mail Exchange Record</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <form asp-action="MailExchangeRecord" asp-controller="Domains">
                    @* <div class="input-group mb-6"> *@
                    @*     <span class="input-group-text" id="ip">Address</span> *@
                    @*     <input asp-for="@Model.IpAddress" type="text" class="form-control" placeholder="IP" aria-label="ip" aria-describedby="ip" /> *@
                    @* </div> *@
                    <div class="input-group mb-6">
                        <span class="input-group-text" id="url">Domain</span>
                        <input asp-for="@Model.Domain" value="@Model.Domain" type="text" class="form-control" placeholder="URL" aria-describedby="url" />
                    </div>
                    <button type="submit" class="btn btn-primary">Check</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card mb-6">
            <h5 class="card-header">Result</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <div class="input-group">
                    <span class="input-group-text">Result</span>
                    <textarea class="form-control" aria-label="With textarea" placeholder="Comment" readonly>
                        @{
                            if (Model != null && !string.IsNullOrEmpty(Model.MailExchange[0]))
                            {
                                @Model.MailExchange
                            }
                        }
                    </textarea>
                </div>
            </div>
        </div>
    </div>
</div>
