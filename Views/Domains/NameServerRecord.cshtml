@{
    ViewData["Title"] = "Name Server Record";
}
@model AspnetCoreMvcFull.Models.Record

@* ************** Content ************** *@
<div class="row g-6">
    <div class="col-md-4">
        <div class="card mb-6">
            <h5 class="card-header">Name Server Record</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <form asp-action="NameServerRecord" asp-controller="Domains" method="post">
                    <div class="input-group mb-6">
                        <input asp-for="Domain" value="@Model.Domain" type="text" class="form-control" placeholder="URL" aria-label="ip" aria-describedby="ip" />
                    </div>
                    <button type="submit" class="btn btn-primary">Check</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card mb-6">
            <h5 class="card-header">Result</h5>
            <div class="card-body demo-vertical-spacing demo-only-element">
                <div class="input-group">
                    <span class="input-group-text">Name Server</span>
                    <table>
                        <tr>
                            <th>Host Name</th>
                            <th>IP Address</th>
                        </tr>
                        @if (Model != null && Model.NameServers != null)
                        {
                            foreach (var ns in Model.NameServers)
                            {
                                @* <tr> *@
                                @*     <td>@ns.HostName</td> *@
                                @*     <td>@ns.IpAddress</td> *@
                                @* </tr> *@
                                <td>@ns</td>
                            }
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
